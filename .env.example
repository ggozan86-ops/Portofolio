# Canonical site URL, used by metadata (Open Graph/Twitter/canonical),
# robots.ts, and sitemap.ts. Set this in Vercel's Project Settings →
# Environment Variables for both Production and Preview so each
# deployment reports its own correct URL instead of the placeholder.
#
# Production example: https://yourdomain.com
# Preview example:     https://your-project-git-branch.vercel.app
NEXT_PUBLIC_SITE_URL=https://example.com
